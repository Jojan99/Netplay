{
  "version": "7.0",
  "data_api_version": "3.0",
  "routing_model": {
    "DETALLE": [
      "METODO"
    ],
    "METODO": [
      "NEQUI",
      "AFUERA",
      "LISTO"
    ],
    "NEQUI": [
      "LISTO"
    ],
    "AFUERA": [
      "LISTO"
    ],
    "LISTO": []
  },
  "screens": [
    {
      "id": "DETALLE",
      "title": "Detalle de tu pago",
      "terminal": false,
      "data": {
        "concepto": {
          "type": "string",
          "__example__": "3 facturas pendientes"
        },
        "total": {
          "type": "string",
          "__example__": "$ 210.000"
        },
        "facturas": {
          "type": "string",
          "__example__": "NT15110 · NT15460 · NT16352"
        },
        "empresa": {
          "type": "string",
          "__example__": "Netplay SAS"
        },
        "opciones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "nequi",
              "title": "Nequi",
              "description": "Se aprueba al instante desde tu app, sin salir de WhatsApp"
            },
            {
              "id": "bancolombia",
              "title": "Botón Bancolombia",
              "description": "Salís a tu banco para aprobar y volvés al chat"
            },
            {
              "id": "daviplata",
              "title": "Daviplata",
              "description": "Salís a Daviplata para autorizar el pago"
            },
            {
              "id": "pse",
              "title": "PSE",
              "description": "Salís a tu banco con tu usuario y clave"
            },
            {
              "id": "tarjeta",
              "title": "Tarjeta de crédito o débito",
              "description": "Salís a una página segura para poner los datos de la tarjeta"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "Image",
            "src": "",
            "height": 140,
            "scale-type": "cover",
            "alt-text": "Pagá en segundos sin salir de WhatsApp"
          },
          {
            "type": "TextCaption",
            "text": "Total a pagar"
          },
          {
            "type": "TextHeading",
            "text": "${data.total}"
          },
          {
            "type": "TextBody",
            "text": "${data.concepto}"
          },
          {
            "type": "TextCaption",
            "text": "${data.facturas}"
          },
          {
            "type": "TextCaption",
            "text": "Al continuar, ${data.empresa} registra este pago en tu cuenta."
          },
          {
            "type": "Footer",
            "label": "Iniciar pago",
            "left-caption": "Pago seguro",
            "right-caption": "${data.total}",
            "on-click-action": {
              "name": "navigate",
              "next": {
                "type": "screen",
                "name": "METODO"
              },
              "payload": {
                "opciones": "${data.opciones}",
                "total": "${data.total}"
              }
            }
          }
        ]
      }
    },
    {
      "id": "METODO",
      "title": "Método de pago",
      "terminal": false,
      "data": {
        "total": {
          "type": "string",
          "__example__": "$ 210.000"
        },
        "opciones": {
          "type": "array",
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "type": "string"
              },
              "title": {
                "type": "string"
              },
              "description": {
                "type": "string"
              }
            }
          },
          "__example__": [
            {
              "id": "nequi",
              "title": "Nequi",
              "description": "Se aprueba al instante desde tu app, sin salir de WhatsApp"
            },
            {
              "id": "bancolombia",
              "title": "Botón Bancolombia",
              "description": "Salís a tu banco para aprobar y volvés al chat"
            },
            {
              "id": "daviplata",
              "title": "Daviplata",
              "description": "Salís a Daviplata para autorizar el pago"
            },
            {
              "id": "pse",
              "title": "PSE",
              "description": "Salís a tu banco con tu usuario y clave"
            },
            {
              "id": "tarjeta",
              "title": "Tarjeta de crédito o débito",
              "description": "Salís a una página segura para poner los datos de la tarjeta"
            }
          ]
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "Vas a pagar"
          },
          {
            "type": "TextHeading",
            "text": "${data.total}"
          },
          {
            "type": "Form",
            "name": "eleccion",
            "children": [
              {
                "type": "RadioButtonsGroup",
                "name": "metodo",
                "label": "¿Con qué querés pagar?",
                "required": true,
                "data-source": "${data.opciones}"
              },
              {
                "type": "Footer",
                "label": "Continuar",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "paso": "metodo",
                    "metodo": "${form.metodo}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "NEQUI",
      "title": "Pagar con Nequi",
      "terminal": false,
      "data": {
        "total": {
          "type": "string",
          "__example__": "$ 210.000"
        },
        "celular": {
          "type": "string",
          "__example__": "3001234567"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "Cobro por Nequi"
          },
          {
            "type": "TextHeading",
            "text": "${data.total}"
          },
          {
            "type": "TextBody",
            "text": "Te mandamos el cobro a tu Nequi y lo aprobás desde la app. No tenés que salir de WhatsApp."
          },
          {
            "type": "Form",
            "name": "datos",
            "init-values": {
              "celular": "${data.celular}"
            },
            "children": [
              {
                "type": "TextInput",
                "name": "celular",
                "label": "No. de celular",
                "input-type": "phone",
                "required": true,
                "helper-text": "Número de celular sin guiones ni espacios."
              },
              {
                "type": "Footer",
                "label": "Enviar el cobro",
                "left-caption": "Nequi",
                "right-caption": "${data.total}",
                "on-click-action": {
                  "name": "data_exchange",
                  "payload": {
                    "paso": "nequi",
                    "celular": "${form.celular}"
                  }
                }
              }
            ]
          }
        ]
      }
    },
    {
      "id": "AFUERA",
      "title": "Continuar en el banco",
      "terminal": false,
      "data": {
        "banco": {
          "type": "string",
          "__example__": "Bancolombia"
        },
        "total": {
          "type": "string",
          "__example__": "$ 210.000"
        },
        "aviso": {
          "type": "string",
          "__example__": "Vas a salir de WhatsApp para aprobar."
        },
        "enlace": {
          "type": "string",
          "__example__": "https://netvula.com/api/pay/abc"
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextCaption",
            "text": "${data.banco}"
          },
          {
            "type": "TextHeading",
            "text": "${data.total}"
          },
          {
            "type": "TextBody",
            "text": "${data.aviso}"
          },
          {
            "type": "EmbeddedLink",
            "text": "Abrir el banco y aprobar",
            "on-click-action": {
              "name": "open_url",
              "url": "${data.enlace}"
            }
          },
          {
            "type": "TextCaption",
            "text": "Cuando termines, volvé al chat: te confirmamos acá mismo en cuanto el pago entre."
          },
          {
            "type": "Footer",
            "label": "Ya lo abrí",
            "on-click-action": {
              "name": "data_exchange",
              "payload": {
                "paso": "afuera"
              }
            }
          }
        ]
      }
    },
    {
      "id": "LISTO",
      "title": "Listo",
      "terminal": true,
      "success": true,
      "data": {
        "encabezado": {
          "type": "string",
          "__example__": "Te enviamos el cobro"
        },
        "mensaje": {
          "type": "string",
          "__example__": "Abrí tu Nequi y aprobá el cobro."
        },
        "nota": {
          "type": "string",
          "__example__": "Apenas lo apruebes, quedás al día."
        }
      },
      "layout": {
        "type": "SingleColumnLayout",
        "children": [
          {
            "type": "TextHeading",
            "text": "${data.encabezado}"
          },
          {
            "type": "TextBody",
            "text": "${data.mensaje}"
          },
          {
            "type": "TextCaption",
            "text": "${data.nota}"
          },
          {
            "type": "Footer",
            "label": "Cerrar",
            "on-click-action": {
              "name": "complete",
              "payload": {}
            }
          }
        ]
      }
    }
  ]
}